# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Database
# Local:    postgresql://postgres:postgres@localhost:5432/foodapp
# Render:   use the "Internal Database URL" Render gives you for your Postgres instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodapp

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of this app (used to build Paystack callback URL). For local dev with ngrok,
# set this to your ngrok https URL. For Render, set to your Render service URL.
APP_BASE_URL=http://localhost:5000
